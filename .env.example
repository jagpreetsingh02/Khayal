# Copy to .env and fill in only what you have. Mock mode needs no keys.

# --- Modes ---
APP_MODE=mock                 # mock | dev | aws
CHANNEL=simulator             # simulator | telegram | twilio
LLM_PROVIDER=mock             # mock | groq | bedrock
STORAGE=sqlite                # sqlite | dynamodb
VOICE=none                    # none | elevenlabs

# --- Local services ---
DATABASE_URL=sqlite:///./care_circle.db
MCP_SERVER_URL=http://localhost:8001/mcp

# --- Groq (dev LLM: vision + agent) ---
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b    # Groq vision model (checked 22 Nov 2026: /openai/v1/models + docs/vision)
GROQ_AGENT_MODEL=             # a Groq model that supports tool calling

# --- Channels ---
TELEGRAM_BOT_TOKEN=           # from @BotFather (CHANNEL=telegram)
TELEGRAM_MODE=polling         # polling (local, no public URL) | webhook
TELEGRAM_WEBHOOK_SECRET=      # webhook mode only: secret_token given to setWebhook
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_TEMPLATE_CONTENT_SID=  # a Sandbox template's Content SID (HX...) for alerts outside 24 h
PUBLIC_BASE_URL=              # public https URL Twilio calls (for X-Twilio-Signature), e.g. ngrok

# --- Voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- AWS (hack day) ---
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=

# --- Dashboard ---
DASHBOARD_DEMO_TOKEN=change-me   # family dashboard sign-in (demo auth); change before sharing
TZ=Asia/Kolkata
