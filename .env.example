# Copy to .env and fill in only what you have. Mock mode needs no keys.

# --- Modes ---
APP_MODE=mock                 # mock | dev | aws
CHANNEL=simulator             # simulator | telegram | twilio
LLM_PROVIDER=mock             # mock | groq | bedrock
STORAGE=sqlite                # sqlite | dynamodb
VOICE=none                    # none | elevenlabs

# --- Local services ---
DATABASE_URL=sqlite:///./care_circle.db
MCP_SERVER_URL=http://localhost:8001/mcp

# --- Groq (dev LLM: vision + agent) ---
GROQ_API_KEY=
GROQ_VISION_MODEL=            # check console.groq.com/docs/models (a vision-capable model)
GROQ_AGENT_MODEL=             # a Groq model that supports tool calling

# --- Channels ---
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- AWS (hack day) ---
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=

# --- Dashboard ---
DASHBOARD_DEMO_TOKEN=change-me
TZ=Asia/Kolkata
