# Copy to .env and fill in only what you have. Mock mode needs no keys.

# --- Modes ---
APP_MODE=mock                 # mock | dev | aws
CHANNEL=simulator             # simulator | telegram | twilio
LLM_PROVIDER=mock             # mock | groq | bedrock
STORAGE=sqlite                # sqlite | dynamodb
VOICE=mock                    # none | mock (voice-note bubbles, browser voice) | elevenlabs
CALL_PROVIDER=mock            # red-alert call: none | mock (call card in simulator) | twilio

# --- Local services ---
DATABASE_URL=sqlite:///./khayal.db
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_HOST=127.0.0.1            # interface the MCP server binds; Docker Compose sets 0.0.0.0 for its mcp container only
MCP_ALLOWED_HOSTS=            # extra Host names the MCP server accepts (comma separated); localhost, mcp and MCP_SERVER_URL's host always are

# --- Groq (dev LLM: vision + agent) ---
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b    # Groq vision model (checked 22 Nov 2026: /openai/v1/models + docs/vision)
GROQ_AGENT_MODEL=             # a Groq model that supports tool calling

# --- Channels ---
TELEGRAM_BOT_TOKEN=           # from @BotFather (CHANNEL=telegram)
TELEGRAM_MODE=polling         # polling (local, no public URL) | webhook
TELEGRAM_WEBHOOK_SECRET=      # webhook mode only: secret_token given to setWebhook
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_TEMPLATE_CONTENT_SID=  # a Sandbox template's Content SID (HX...) for alerts outside 24 h
PUBLIC_BASE_URL=              # public https URL Twilio calls (for X-Twilio-Signature), e.g. ngrok

# --- Voice ---
ELEVENLABS_API_KEY=           # VOICE=elevenlabs: TTS voice notes + Scribe STT (else text only)
ELEVENLABS_VOICE_ID=          # a voice from your ElevenLabs voice library
ELEVENLABS_TTS_MODEL=eleven_v4_turbo     # lists Hindi + Tamil; eleven_flash_v2_5 is cheaper
ELEVENLABS_STT_MODEL=scribe_v3
ELEVENLABS_DAILY_CHAR_BUDGET=1500        # TTS chars/day; cached phrases are free; over -> text
VOICE_CACHE_DIR=./.voice_cache
TWILIO_CALL_FROM=             # CALL_PROVIDER=twilio: your Twilio voice number (+1...)

# --- AWS (hack day) ---
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=

# --- Tests ---
RUN_LIVE_TESTS=0              # 1 = also run tests that call real APIs (uses your quota)

# --- Dashboard sign-in and security ---
DASHBOARD_DEMO_TOKEN=change-me   # demo-token sign-in, APP_MODE=mock only (dev/aws: one-time codes only)
SESSION_SECRET=               # signs dashboard sessions + login-code hashes; required in dev/aws (32+ chars); empty in mock = random per start
SESSION_TTL_HOURS=12          # how long a dashboard session lasts
MCP_AUTH_MODE=token           # token: a signed 60 s token per MCP call (required in dev/aws); secret: legacy shared bearer, mock only
MCP_TOKEN_SECRET=             # signs those tokens (HS256, 32+ chars); required in dev/aws; empty in mock = start.py / Docker make one per run (set it to use the family gateway)
MCP_SHARED_SECRET=            # legacy bearer for MCP_AUTH_MODE=secret (mock only); empty = start.py / Docker make one
FAMILY_GATEWAY_MEMBER_ID=     # scripts/family_gateway.py: the family member (mem_...) its read-only tokens are for; see docs/FAMILY_MCP.md
TZ=Asia/Kolkata
INBOX_RETENTION_DAYS=7        # days to keep processed inbox rows (metadata only) and failed ones
